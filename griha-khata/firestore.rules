rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything the app uses lives in one collection: griha_khata
    // Documents: members, categories, seeded_months, expenses:YYYY-MM
    match /griha_khata/{docId} {
      allow read, write: if true;
    }
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
